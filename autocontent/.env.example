# ===== AutoContent 설정 =====
# 무료 LLM 키만 있으면 나머지는 전부 키 없이 동작합니다.
# 키 발급: https://api.chatanywhere.tech/v1/oauth/free/render

# OpenAI 호환 엔드포인트 (chatanywhere 무료 API)
OPENAI_API_KEY=여기에_무료_키_붙여넣기
OPENAI_BASE_URL=https://api.chatanywhere.tech/v1

# 글 작성에 쓸 모델 (무료 키에서 동작하는 모델 권장)
WRITER_MODEL=gpt-4o-mini

# 중복 방지용 임베딩 모델 / 유사도 임계값(0~1, 높을수록 엄격하게 중복 처리)
EMBED_MODEL=text-embedding-3-small
DEDUPE_THRESHOLD=0.88

# 내레이션 음성 (edge-tts voice 이름). 한국어: ko-KR-SunHiNeural / ko-KR-InJoonNeural
TTS_VOICE=ko-KR-SunHiNeural

# 출력 언어 (글/스크립트 작성 언어)
OUTPUT_LANG=한국어
